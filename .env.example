# ============================================================
# Eyohe OSINT — environment configuration
# Copy to .env and adjust. Never commit .env.
# ============================================================

# --- General ---
EYOHE_ENV=development                  # development | production
SECRET_KEY=change-me-generate-a-long-random-string
API_HOST=0.0.0.0
API_PORT=8000
WEB_PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
LOG_JSON=true

# --- Database ---
# PostgreSQL (recommended):
DATABASE_URL=postgresql+asyncpg://eyohe:eyohe@127.0.0.1:5432/eyohe
# SQLite development fallback:
# DATABASE_URL=sqlite+aiosqlite:///./data/eyohe.sqlite3

# --- Redis (cache, rate limiting, event fan-out, arq jobs) ---
REDIS_URL=redis://127.0.0.1:6379/0

# --- Background jobs: embedded (in API process) or arq (separate worker) ---
JOB_BACKEND=embedded

# --- Graph backend: postgresql (default) or neo4j (optional, heavier) ---
GRAPH_BACKEND=postgresql
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --- Local AI (Ollama) ---
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_NUM_CTX=16384

# --- Search providers ---
# Comma-separated priority list. Each provider must be configured to be usable.
SEARCH_PROVIDERS=searxng
SEARXNG_URL=http://127.0.0.1:8080
BRAVE_API_KEY=
SERPER_API_KEY=
TAVILY_API_KEY=

# --- Collector credentials (public API access only) ---
GITHUB_TOKEN=
REDDIT_USER_AGENT=eyohe-osint/0.1 (public research tool)

# --- Investigation bounds ---
MAX_AGENT_ITERATIONS=50
MAX_RESEARCH_DEPTH=2
MAX_QUERIES=40
MAX_PAGES=60
MAX_RUNTIME_SECONDS=1800
MAX_RESULTS_PER_SOURCE=20
MAX_RESULTS=100
REQUEST_TIMEOUT=20
MAX_FETCH_BYTES=5000000

# --- Evidence storage ---
DATA_DIR=./data
EVIDENCE_RETENTION_DAYS=0              # 0 = keep forever
SNAPSHOT_MAX_TEXT_CHARS=200000

# --- Security ---
SESSION_TTL_HOURS=24
COOKIE_SECURE=false                    # true behind HTTPS (Caddy)
ALLOW_PRIVATE_NETWORK_FETCH=false      # DANGEROUS: only for local testing of your own services
RATE_LIMIT_PER_MINUTE=240
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Notifications (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ALERT_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Reports ---
REPORT_CLASSIFICATION=RESEARCH         # INTERNAL | RESEARCH | CONFIDENTIAL
CHROMIUM_PATH=/usr/bin/chromium

# --- Docker Compose only ---
POSTGRES_USER=eyohe
POSTGRES_PASSWORD=eyohe
POSTGRES_DB=eyohe
